{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "scripts"]
}
